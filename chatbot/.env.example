# ── LLM ─────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash 

# ── Embedding ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# ── Vector DB (chọn một) ─────────────────────────────────────
VECTOR_DB_PROVIDER=qdrant

## Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=HTTM

# ── BM25 Sparse Index ────────────────────────────────────────
BM25_STORE_PATH=./bm25/bm25_index

# ── Reranker (chọn một) ──────────────────────────────────────
RERANKER_PROVIDER=bge             # cohere | bge 
COHERE_API_KEY=...

BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=20                      # số docs đưa vào reranker
RERANK_TOP_N=5                       # số docs trả về sau rerank

# ── MongoDB ──────────────────────────────────────────────────
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=rag_chatbot
# SESSIONS_COLLECTION=sessions
# HISTORY_MAX_MESSAGES=20              # số messages giữ trong context window
# HISTORY_MAX_TOKENS=4096              # trim khi tổng token vượt ngưỡng này

# ── App ──────────────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_HOST=0.0.0.0
APP_PORT=8001
SECRET_KEY="super_secret_key_for_local_development_environment_12345"
ALLOWED_ORIGINS=http://localhost:5173
API_RATE_LIMIT=60/minute             # request/phút per IP

# ── Chunking ─────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=150